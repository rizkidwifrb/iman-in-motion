# Frontend API base URL.
# Kosongkan jika backend Express berada di domain yang sama.
# Untuk cPanel static-only, isi dengan URL backend production seperti Render/Railway/VPS.
VITE_API_BASE_URL=https://iman-in-motion.vercel.app

# Firebase web config untuk login/register, favorite, statistik mood, dan akun.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend-only variables, dipakai oleh app.js jika backend Express dijalankan di hosting Node.js terpisah.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
TMDB_API_KEY=
TMDB_READ_TOKEN=
TMDB_BEARER_TOKEN=
PORT=8080
